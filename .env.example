# Base de datos
MYSQL_ROOT_PASSWORD=cambiame_root
MYSQL_DATABASE=grandcasino
MYSQL_USER=casinouser
MYSQL_PASSWORD=cambiame_pass

# Sesiones (genera uno con: openssl rand -hex 32)
SESSION_SECRET=cambiame_secret

# --- Desarrollo local ---
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080
# DOMAIN no hace falta en local

# --- Producción (docker-compose.prod.yml) ---
# NODE_ENV=production
# FRONTEND_ORIGIN=https://tudominio.com   (o http://ip si no tienes dominio)
# DOMAIN=tudominio.com                    (o http://ip para sin HTTPS)
